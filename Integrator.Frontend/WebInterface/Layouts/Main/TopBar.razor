@using Microsoft.AspNetCore.Components.Authorization
@using Integrator.Frontend.WebInterface.Layouts.Main.Components
@inject NavigationManager NavigationManager

<MudAppBar Elevation="0" Color="Color.Transparent">
    <MudIconButton Icon="@Icons.Material.Outlined.MenuOpen" Color="Color.Inherit" OnClick="DrawerToggle"></MudIconButton>
    <MudSpacer></MudSpacer>
    <MudIconButton Icon="@Icons.Material.Outlined.Notifications" aria-label="notifications"></MudIconButton>
    
    <ThemeSelector IsDarkMode="IsDarkMode" OnThemeButtonClick="ChangeTheme"></ThemeSelector>
    
    <MudMenu Class="ml-2" Dense="true">
        <ActivatorContent>
            <MudAvatar Color="Color.Primary">@_username.ToUpper().ToCharArray()[0]</MudAvatar>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem>Profile</MudMenuItem>
            <MudMenuItem OnClick="Logout">Logout</MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudAppBar>

@code {
    [Parameter]
    public EventCallback DrawerToggleClicked { get; set; }
    
    [Parameter]
    public bool IsDarkMode { get; set; }
    
    [Parameter]
    public EventCallback ChangeThemeClicked { get; set; }
    
    protected async Task DrawerToggle()
    {
        await DrawerToggleClicked.InvokeAsync();
    }

    protected async Task ChangeTheme()
    {
        await ChangeThemeClicked.InvokeAsync();
    }

    protected async Task Logout()
    {
        NavigationManager.NavigateTo("/auth/logout", true);
    }

    [CascadingParameter] 
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    
    private string _username = "Guest";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            var user = authState.User;

            if (user.Identity != null && user.Identity.Name != null)
            {
                _username = user.Identity.Name;
            }
        }

        await base.OnInitializedAsync();
    }
}