@page "/login"
@layout SimpleLayout
@using Integrator.DataAccess.Models.Users
@using Integrator.Frontend.Components.Layouts.Simple
@using Microsoft.AspNetCore.Identity
@using Serilog
@inject NavigationManager NavigationManager
@inject SignInManager<IntegratorUser> SignInManager

<div class="text-center mt-4">
    <h1 class="h2">Welcome back!</h1>
    <p class="lead">
        Sign in to your account to continue
    </p>
</div>

<div class="card">
    <div class="card-body">
        <div class="m-sm-3">
            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-secondary btn-lg" href="index.html">Sign in with TTSK</button>
            </div>
            <div class="row">
                <div class="col">
                    <hr>
                </div>
                <div class="col-auto text-uppercase d-flex align-items-center">Or</div>
                <div class="col">
                    <hr>
                </div>
            </div>
            <EditForm Model="Input" method="post" OnValidSubmit="SignIn" FormName="login">
                <DataAnnotationsValidator/>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="Enter your email"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" @bind-Value="Input.Password" class="form-control form-control-lg" autocomplete="current-password" aria-required="true" placeholder="Enter your password"/>
                    <small>
                        <a href="pages-reset-password.html">Forgot password?</a>
                    </small>
                </div>
                <div class="mb-3">
                    <div class="form-check align-items-center">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" />
                        <label class="form-check-label text-small" for="customControlInline">Remember me</label>
                    </div>
                </div>
                <ValidationSummary class="mb-3 text-danger"/>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <ul class="mb-3 text-danger"><li>@ErrorMessage</li></ul>
                }
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-lg btn-primary">Sign in</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] 
    private LoginModel Input { get; set; } = new() { RememberMe = true };
    private readonly ILogger _logger = Log.ForContext<Login>();
    private string ErrorMessage = ""; 
    
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task SignIn()
    {
        var result = await SignInManager.PasswordSignInAsync("janoxxx", Input.Password, Input.RememberMe, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            _logger.Information("Login succeeded for user: {Email}", Input.Email);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Invalid credentials";
        }
    }
}