@page "/errors/404"
@using Integrator.Frontend.WebInterface.Layouts.Simple
@layout SimpleLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<div class="text-center">
    <h1 class="display-1 fw-bold">404</h1>
    <p class="h2">Page not found.</p>
    <p class="lead fw-normal mt-3 mb-4">The page you are looking for might have been removed.</p>
    <button @onclick="ReturnToHomePage" class="btn btn-primary btn-lg">
        Return to website
    </button>
</div>

@code {
    private void ReturnToHomePage()
    {
        NavigationManager.NavigateTo("/");
    }
}