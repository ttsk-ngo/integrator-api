<MudDrawer Elevation="1" @bind-Open="@DrawerOpen">
    <MudContainer Class="pa-2 my-2 d-flex justify-center align-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"></MudIcon>
        <MudText Typo="Typo.h5" Class="ml-3">Integrator 2.0</MudText>
    </MudContainer>
    
    <MudContainer Class="d-flex justify-center align-center px-4 my-2">
        <MudAvatar Color="Color.Primary">J</MudAvatar>
        <MudContainer Class="d-flex justify-start flex-column pl-4">
            <MudText Typo="Typo.body1">Janoxxx</MudText>
            <MudText Typo="Typo.body2">Developer</MudText>
        </MudContainer>
    </MudContainer>
    
    <MudNavMenu Bordered="true">
        <MudDivider Class="my-2"/>
        <MudNavLink Icon="@Icons.Material.Outlined.Dashboard" Href="/" Match="NavLinkMatch.All">Dashboard</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Outlined.Announcement" Href="/complaints" Match="NavLinkMatch.Prefix">Complaints</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Outlined.CreditCard" Href="/billing" Disabled="true">Donations</MudNavLink>
        <MudNavGroup Title="Settings" Expanded="true" Disabled="true">
            <MudNavLink Href="/users">Users</MudNavLink>
            <MudNavLink Href="/security">Security</MudNavLink>
        </MudNavGroup>
        <MudNavLink Href="/about" Disabled="true">About</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    [Parameter]
    public bool DrawerOpen { get; set; }
}