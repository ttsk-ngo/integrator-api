@page "/complaints"
@using System.ComponentModel
@using Integrator.DataAccess.Models.Complaints
@using Integrator.Frontend.WebInterface.ViewModels.Complaints
@using Integrator.Frontend.WebInterface.Pages.Complaints
@implements IDisposable

@inject IComplaintsViewModel ViewModel

<PageTitle>Complaints</PageTitle>

<MudDataGrid T="IComplaint" @ref="grid" Items="ViewModel.Complaints" DragDropColumnReordering="true" ColumnsPanelReordering="true"
             ColumnResizeMode="ResizeMode.Column" Hideable="true" Filterable="true"
             Groupable="true" FilterMode="DataGridFilterMode.Simple" ShowMenuIcon="true">
    <Columns>
        <SelectColumn T="IComplaint" />
        <PropertyColumn Property="x => x.Number" Title="#" Hidden="false" Grouping="false"
                        Hideable="false" Filterable="true" Groupable="false" Sortable="true" DragAndDropEnabled="false" />

        @* <PropertyColumn Property="x => x.Sign" Hidden="true" DragAndDropEnabled="false" Groupable="false" Filterable="false" Sortable="false" /> *@

        @* <PropertyColumn Property="x => x.Nickname" Title="Nickname" Hidden="false" DragAndDropEnabled="true" Groupable="true"  Filterable="true" Grouping="false" /> *@

        <PropertyColumn Property="x => x.Context" Title="Context" Hidden="false" Grouping="false"
                        Hideable="false" Filterable="true" Groupable="true" Sortable="true" />

        <PropertyColumn Property="x => x.Accuser()" Title="Victim" Hidden="false" Grouping="false"
                        Hideable="false" Filterable="true" Groupable="true" Sortable="true" />

        <PropertyColumn Property="x => x.Accused()" Title="Accused" Hidden="false" Grouping="false"
                        Hideable="false" Filterable="true" Groupable="true" Sortable="true" />

        <PropertyColumn Property="x => x.Witnesses()" Title="Witnesses" Hidden="false" Grouping="false"
                        Hideable="true" Filterable="true" Groupable="false" Sortable="true" />

        <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="dd/MM/yyyy" Hidden="false" Grouping="false" 
                        Hideable="true" Filterable="true" Groupable="true" Sortable="true" />

        <PropertyColumn Property="x => x.UpdatedAt" Title="Updated" Format="dd/MM/yyyy HH:mm" Hidden="false" Grouping="false"
                        Hideable="true" Filterable="true" Groupable="false" Sortable="true" />

        <PropertyColumn Property="x => x.Status" Title="Status" Hidden="false" Grouping="false"
                        Hideable="false" Filterable="true" Groupable="true" Sortable="true" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="IComplaint" />
    </PagerContent>
</MudDataGrid>

@code {
    [Inject] IDialogService DialogService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnPropertyChangedHandler;
        await ViewModel.LoadComplaintsAsync();
        await base.OnInitializedAsync();
    }

    async void OnPropertyChangedHandler(object? sender, PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnPropertyChangedHandler;
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialogRef = await DialogService.ShowAsync<DialogNewComplain>("Create a new complain", options);
        var result = await dialogRef.Result;

        if (!result.Canceled)
        {
            var complainData = result.Data;
        }
    }

    public MudDataGrid<IComplaint> grid = null;

