@page "/seed"
@using Integrator.DataAccess.Models.Users
@using Microsoft.AspNetCore.Identity
@inject UserManager<IntegratorUser> UserManager
<h3>Seed</h3>
<p>
    Username: @_userName<br/>
    Email: @_email<br/>
    Password: @_password<br/>
</p>
@_warning

@code {
    private string _userName = "";
    private string _email = "";
    private string _password = "";
    private string _warning = "";
    
    protected override async Task OnInitializedAsync()
    {
        var user = new IntegratorUser()
        {
            Email = "janoxxx@ttsk.ngo",
            UserName = "janoxxx"
        };
        var result = await UserManager.CreateAsync(user, "Password123!");

        if (result.Succeeded)
        {
            _userName = "janoxxx";
            _email = "janoxxx@ttsk.ngo";
            _password = "Password123!";
        }
        else
        {
            _warning = "seeding failed...";
        }

        await base.OnInitializedAsync();
    }

}