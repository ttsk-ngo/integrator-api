@page "/login"
@using Integrator.Frontend.Components.Layouts.Simple
@using Integrator.Frontend.Services.Auth
@using Integrator.Frontend.Services.Login
@using Microsoft.AspNetCore.Components.Authorization
@using Serilog
@layout SimpleLayout
@rendermode InteractiveServer
@inject ILoginService LoginService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="text-center mt-4">
    <h1 class="h2">Welcome back!</h1>
    <p class="lead">
        Sign in to your account to continue
    </p>
</div>

<div class="card">
    <div class="card-body">
        <div class="m-sm-3">
            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-secondary btn-lg" href="index.html">Sign in with TTSK</button>
            </div>
            <div class="row">
                <div class="col">
                    <hr>
                </div>
                <div class="col-auto text-uppercase d-flex align-items-center">Or</div>
                <div class="col">
                    <hr>
                </div>
            </div>
            <EditForm Model="LoginModel" OnValidSubmit="SignIn" FormName="SignInForm">
                <DataAnnotationsValidator></DataAnnotationsValidator>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="LoginModel!.Email" class="form-control form-control-lg" type="email" name="email" placeholder="Enter your email"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="LoginModel!.Password" class="form-control form-control-lg" type="password" name="password" placeholder="Enter your password"/>
                    <small>
                        <a href="pages-reset-password.html">Forgot password?</a>
                    </small>
                </div>
                <div class="mb-3">
                    <div class="form-check align-items-center">
                        <InputCheckbox @bind-Value="LoginModel!.RememberMe" id="customControlInline" type="checkbox" class="form-check-input" name="remember-me"/>
                        <label class="form-check-label text-small" for="customControlInline">Remember me</label>
                    </div>
                </div>
                <ValidationSummary class="mb-3 text-danger"></ValidationSummary>
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-lg btn-primary">Sign in</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<div class="text-center mb-3">
    Don't have an account? <a href="pages-sign-up.html">Sign up</a>
</div>

@code {
    [SupplyParameterFromForm] private LoginModel? LoginModel { get; set; } = new() { RememberMe = true };
    private readonly ILogger _logger = Log.ForContext<Login>();

    private async Task SignIn()
    {
        _logger.Information("Initiating SignIn");
        await LoginService.Login(new LoginRequest()
        {
            Email = LoginModel!.Email,
            Password = LoginModel!.Password,
            RememberMe = LoginModel!.RememberMe
        });

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        
        Navigation.NavigateTo("/");
    }
}